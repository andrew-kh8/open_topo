module OpenTopo
  module Net
    module Params
      class ElevationParams < BaseParams
        @long: untyped

        @lat: untyped

        @dataset: untyped

        DATASETS: { anadem: "ANADEM", arctic_dem10m: "ArcticDEM10m", arctic_dem2m: "ArcticDEM2m", arctic_dem32m: "ArcticDEM32m", aw3_d30_e: "AW3D30_E", aw3_d30: "AW3D30", ca_mrdem_dsm: "CA_MRDEM_DSM", ca_mrdem_dtm: "CA_MRDEM_DTM", cop30: "COP30", cop90: "COP90", eu_dtm: "EU_DTM", gebco_ice_topo: "GEBCOIceTopo", gebco_sub_ice_topo: "GEBCOSubIceTopo", gedi_l3: "GEDI_L3", gedtm30: "GEDTM30", linz1m_dsm: "LINZ1m_DSM", linz1m_dtm: "LINZ1m_DTM", nasadem: "NASADEM", rema10m: "REMA10m", rema2m: "REMA2m", rema32m: "REMA32m", srtm15_plus: "SRTM15Plus", srtmgl1_e: "SRTM_GL1_Ellip", srtmgl1: "SRTM_GL1", srtmgl3: "SRTM_GL3", usgs10m: "USGS10m", usgs30m: "USGS30m" }

        attr_reader long: untyped

        attr_reader lat: untyped

        attr_reader dataset: untyped

        def initialize: (long: untyped, lat: untyped, ?dataset: ::Symbol) -> void

        def to_params: () -> { longitude: untyped, latitude: untyped, dataset: untyped }
      end
    end
  end
end
